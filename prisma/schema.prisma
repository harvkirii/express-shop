generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Имена моделей и полей — как в лабораторной (Category, Product, ...),
// а реальные имена таблиц и колонок в PostgreSQL сохранены через @@map / @map.
// Поэтому база данных не меняется.

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique @db.VarChar(100)
  slug     String?   @unique
  products Product[]

  @@map("categories")
}

model Product {
  id         Int         @id @default(autoincrement())
  name       String      @db.VarChar(150)
  price       Int
  description String?
  categoryId  Int         @map("category_id")
  inStock    Boolean     @default(true) @map("in_stock")
  category   Category    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@map("products")
}

model User {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(100)
  email        String       @unique @db.VarChar(150)
  passwordHash String       @map("password_hash") @db.VarChar(100)
  role         String       @default("customer") @db.VarChar(20)
  orders       Order[]
  profile      UserProfile?

  @@map("users")
}

model UserProfile {
  userId  Int     @id @map("user_id")
  phone   String? @db.VarChar(30)
  address String? @db.VarChar(250)
  user    User    @relation(fields: [userId], references: [id])

  @@map("user_profiles")
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    Int         @map("user_id")
  status    String      @default("new") @db.VarChar(30)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User        @relation(fields: [userId], references: [id])
  items     OrderItem[]

  @@map("orders")
}

model OrderItem {
  orderId   Int     @map("order_id")
  productId Int     @map("product_id")
  quantity  Int
  price     Int
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@id([orderId, productId])
  @@map("order_items")
}
