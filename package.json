{
  "name": "express-shop",
  "version": "1.0.0",
  "description": "Internet Shop API (Express + Prisma/PostgreSQL) — готов к production (лр5)",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env server.js",
    "start": "node server.js",
    "start:prod:local": "node --env-file=.env.production server.js",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "setupFiles": ["<rootDir>/tests/setupEnv.cjs"],
    "testMatch": ["<rootDir>/tests/**/*.test.js"]
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "dotenv": "^16.4.5",
    "jest": "^29.7.0",
    "prisma": "^7.10.1",
    "supertest": "^7.0.0"
  }
}
